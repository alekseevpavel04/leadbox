# Production bot token from @BotFather
BOT_TOKEN=
# Separate bot for local polling, so the stand's webhook stays untouched
DEV_BOT_TOKEN=
# Manager group for new-lead notifications (negative id for groups)
MANAGER_CHAT_ID=-1000000000000
# Neon connection string as copied from the console, e.g.
# postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# For local work without Postgres: sqlite+aiosqlite:///leadbox.db (needs the dev extras; run `alembic upgrade head` first).
DATABASE_URL=
# Public URL of the stand, used for the webhook and links in notifications
PUBLIC_BASE_URL=https://leadbox.onrender.com
# Random strings, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
SESSION_SECRET=
# Demo CRM login
CRM_USER=demo
CRM_PASSWORD=
# webhook on the stand, polling locally
BOT_MODE=polling
